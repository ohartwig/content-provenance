        <body>
            <!-- Frontend marking. The wording follows the EU icons, which carry
                 "AI GENERATED" / "AI MODIFIED" in the artwork itself — the text
                 here is the accessible name, so it says the same thing in the
                 page language rather than inventing a different phrasing. -->
            <trans-unit id="ai_badge.generated" resname="ai_badge.generated">
                <source>AI generated</source>
                <target>KI-generiert</target>
            </trans-unit>
            <trans-unit id="ai_badge.modified" resname="ai_badge.modified">
                <source>AI modified</source>
                <target>KI-bearbeitet</target>
            </trans-unit>
            <trans-unit id="cr_badge.aria" resname="cr_badge.aria">
                <source>Content Credentials attached — show details</source>
                <target>Content Credentials vorhanden — Details anzeigen</target>
            </trans-unit>
            <trans-unit id="cr_badge.stripped" resname="cr_badge.stripped">
                <source>Content Credentials were removed from this file</source>
                <target>Content Credentials wurden aus dieser Datei entfernt</target>
            </trans-unit>
            <trans-unit id="cr_panel.heading" resname="cr_panel.heading">
                <source>Content Credentials</source>
                <target>Content Credentials</target>
            </trans-unit>
            <trans-unit id="cr_panel.signer" resname="cr_panel.signer">
