            </trans-unit>
            <trans-unit id="cr_live.error" resname="cr_live.error">
                <source>The live check did not answer. The details above are from our records.</source>
                <target>Die Live-Prüfung hat nicht geantwortet. Die Angaben oben stammen aus unseren Daten.</target>
            </trans-unit>
            <trans-unit id="cr_panel.raw" resname="cr_panel.raw">
                <source>Open the raw verification data</source>
                <target>Rohdaten der Prüfung öffnen</target>
